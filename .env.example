# ─────────────────────────────────────────────────────────────────────────────
# Mvaak website — environment variables
# Copy to .env.local for development. Never commit real values.
# All lead-routing secrets are read on the server only.
# ─────────────────────────────────────────────────────────────────────────────

# Public canonical URL (used for canonical tags, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://mvaak.com

# ── Lead delivery ────────────────────────────────────────────────────────────
# Each form needs AT LEAST ONE working channel. If none accepts a submission,
# the form shows "We couldn't submit your … Please try again." — it never shows
# a false success message and never opens the visitor's email app.

# 1) Email via Resend (https://resend.com). The FROM address must be on a domain
#    verified in Resend (e.g. forms@mvaak.com).
RESEND_API_KEY=
LEADS_FROM_EMAIL="Mvaak Website <forms@mvaak.com>"
# Where project inquiries go (comma-separate multiple addresses).
LEADS_TO_EMAIL=team@mvaak.com
# Optional separate inbox for partnership applications (defaults to LEADS_TO_EMAIL).
PARTNERSHIP_TO_EMAIL=

# 2) Webhook (CRM, Google Sheets via Apps Script, Zapier/Make, Slack workflow…).
#    Receives JSON: { kind, id, submittedAt, data }.
LEADS_WEBHOOK_URL=
#    Optional: signs the body; header X-Mvaak-Signature: sha256=<hex HMAC>.
LEADS_WEBHOOK_SECRET=

# 3) Local JSONL file store — development or a server with a persistent disk only.
#    Do not use on serverless hosts (files are not persisted).
LEADS_LOCAL_DIR=

# 4) Google Sheets via Apps Script web apps (src/lib/server/lead-sheets.ts).
#    The server posts JSON and shows success only when the script replies e.g.
#    {"status":"success"}. Deployments must allow access by "Anyone".
#    When a form's sheet is set, it is the record of truth; channels 1–3 send copies.
#    Contact Us → { name, email, company, jobTitle, inquiryType, projectDetails }
#      Defaults to the Contact Leads endpoint; override here, or "off" to disable.
CONTACT_SHEETS_URL=
#    Partnership → { name, email, phone, city, country, linkedin, lookingFor, reference }
#      Defaults to the Partnerships endpoint; override here, or "off" to disable.
PARTNERSHIP_SHEETS_URL=

# ── Analytics (optional; nothing loads unless set) ───────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
