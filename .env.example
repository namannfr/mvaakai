# ─────────────────────────────────────────────────────────────────────────────
# Mvaak website — environment variables
# Copy to .env.local for development. Never commit real values.
# All lead-routing secrets are read on the server only.
# ─────────────────────────────────────────────────────────────────────────────

# Public canonical URL (used for canonical tags, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://mvaak.com

# ── Lead delivery ────────────────────────────────────────────────────────────
# Configure AT LEAST ONE channel. Until one is configured, both forms tell
# visitors that online submission is not live and offer a pre-filled email
# instead — they never show a false success message.

# 1) Email via Resend (https://resend.com). The FROM address must be on a domain
#    verified in Resend (e.g. forms@mvaak.com).
RESEND_API_KEY=
LEADS_FROM_EMAIL="Mvaak Website <forms@mvaak.com>"
# Where project inquiries go (comma-separate multiple addresses).
LEADS_TO_EMAIL=team@mvaak.com
# Optional separate inbox for partnership applications (defaults to LEADS_TO_EMAIL).
PARTNERSHIP_TO_EMAIL=

# 2) Webhook (CRM, Google Sheets via Apps Script, Zapier/Make, Slack workflow…).
#    Receives JSON: { kind, id, submittedAt, data }.
LEADS_WEBHOOK_URL=
#    Optional: signs the body; header X-Mvaak-Signature: sha256=<hex HMAC>.
LEADS_WEBHOOK_SECRET=

# 3) Local JSONL file store — development or a server with a persistent disk only.
#    Do not use on serverless hosts (files are not persisted).
LEADS_LOCAL_DIR=

# ── Analytics (optional; nothing loads unless set) ───────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
